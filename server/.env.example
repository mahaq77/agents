# GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/

# --- Atlassian (Jira) remote MCP server ---
# OAuth 2.1 access token. Easiest dev flow:
#   npx @modelcontextprotocol/inspector  ->  Quick OAuth Flow against the server URL.
JIRA_MCP_TOKEN=


# --- Figma remote MCP server (Dev Mode MCP) ---
FIGMA_MCP_TOKEN=
# FIGMA_MCP_URL=https://mcp.figma.com/mcp

# --- Server ---
PORT=3000
CLIENT_ORIGIN=http://localhost:4200
